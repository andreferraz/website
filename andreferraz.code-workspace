{
  "folders": [
    {
      "name": "Next",
      "path": "./"
    }
  ],
  "extensions": {
    "recommendations": [
      // Share editing configurations like indentation, end of line, charset and more
      "editorconfig.editorconfig",
      // .env syntax support
      "mikestead.dotenv",
      // Spell check for comments, strings and plain text
      "streetsidesoftware.code-spell-checker",
      // Linting and formatting for JavaScript and TypeScript using Biome
      "biomejs.biome"
    ]
  },
  "settings": {
    // Enable formatting when saving files
    "editor.formatOnSave": true,
    // Change default code formatter to Biome
    "editor.defaultFormatter": "biomejs.biome",

    // HTML auto formatting options
    "html.format.maxPreserveNewLines": 1,
    "html.format.wrapAttributes": "preserve",
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "cSpell.words": ["andreferraz"]
  }
}
